{
  "family": "ticketing-celery",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "celery-worker",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ticketing-backend:latest",
      "command": ["celery", "-A", "src.tasks.celery_app", "worker", "--loglevel=info"],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/redis-url" },
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/secret-key" },
        { "name": "ENCRYPTION_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/encryption-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticketing-celery",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "worker"
        }
      },
      "essential": true
    },
    {
      "name": "celery-beat",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ticketing-backend:latest",
      "command": ["celery", "-A", "src.tasks.celery_app", "beat", "--loglevel=info"],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/redis-url" },
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/secret-key" },
        { "name": "ENCRYPTION_KEY", "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:ticketing/encryption-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticketing-celery",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "beat"
        }
      },
      "essential": true
    }
  ]
}
